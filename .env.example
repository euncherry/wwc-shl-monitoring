# 프론트 환경변수 (Vite). 실제 값은 .env.development / .env.production 에.
# staging: https://api.staging.smarthearingloop.com  /  prod: https://api.smarthearingloop.com
VITE_API_BASE_URL=https://api.staging.smarthearingloop.com

# MSW 목 활성화. 백엔드 미구현 API만 가로챈다(등록 안 된 경로는 실연동 통과).
# development=true, production=false
VITE_ENABLE_MOCK=true
